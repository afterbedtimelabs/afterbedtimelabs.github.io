{
  "name": "afterbedtimelabs.github.io",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "check": "astro check",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "verify": "node scripts/verify-build.mjs",
    "validate": "npm run check && npm run build && npm run verify && npm run mascot:verify && npm run showcase:verify",
    "showcase:verify": "node scripts/verify-nightstock-showcase.mjs",
    "brand-assets": "node scripts/generate-brand-assets.mjs",
    "mascot:generate": "node scripts/generate-tinker-panda-v3-4.mjs",
    "mascot:verify": "node scripts/verify-tinker-panda-v3-4.mjs && node scripts/verify-tinker-controller.cjs",
    "mascot:review": "node scripts/build-tinker-review.mjs && node scripts/serve-tinker-review.mjs"
  },
  "dependencies": {
    "@astrojs/mdx": "^8.0.2",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.3.5"
  },
  "allowScripts": {
    "esbuild": true
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "typescript": "^6.0.3"
  }
