---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import Workbench from '../components/Workbench.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { featuredProjects } from '../data/projects';
import { getPublishedWriting, articleHref, formatDate, readingTime } from '../lib/writing';
import { site } from '../config/site';
const recentWriting = (await getPublishedWriting()).slice(0, 3);
---
<BaseLayout>
  <div class="container">
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero-copy">
        <p class="eyebrow"><span class="small-rule"></span> An after-hours workshop by Isaac</p>
        <h1 id="hero-title">Built after<br /><em>bedtime.</em></h1>
        <p class="hero-description">A command center for AI experiments. Games with quiet roads, tricky choices, and wobbly cargo. A little desktop company. Here’s what I’ve been building after bedtime.</p>
        <div class="hero-actions"><a class="hero-link" href="#projects-title">Explore the work <Icon name="arrow-right" size={18} /></a><a class="hero-secondary" href="/writing/welcome-to-after-bedtime-labs/">Meet the lab <span aria-hidden="true">↗</span></a></div>
      </div>
      <div class="hero-art"><Workbench /></div>
      <div class="hero-footnote"><span><span class="status-dot" aria-hidden="true"></span> An independent workshop by Isaac</span><span>Software / Local AI / Games</span></div>
    </section>
    <section class="home-section" aria-labelledby="projects-title">
      <div class="section-top"><div><p class="eyebrow"><span class="section-number">01 /</span> Selected projects</p><h2 class="section-heading" id="projects-title">On the workbench</h2></div><a class="text-link" href="/projects/">All projects <Icon name="arrow-up-right" size={16} /></a></div>
      <div class="featured-projects">{featuredProjects.map(project => <ProjectCard project={project} compact spotlight={project.slug === 'mission-control'} />)}</div>
      <aside class="navi-note" aria-label="Project information"><p>These are working prototypes. Explore each project for its current state and what’s next.</p><a href="/navi/privacy/">Navi Gmail Monitor privacy <span aria-hidden="true">↗</span></a></aside>
    </section>
    <section class="home-section writing-section" aria-labelledby="writing-title">
      <div class="section-top"><div><p class="eyebrow"><span class="section-number">02 /</span> Recent writing</p><h2 class="section-heading" id="writing-title">Notes from the lab</h2></div><a class="text-link" href="/writing/">All writing <Icon name="arrow-up-right" size={16} /></a></div>
      {recentWriting.length > 0 ? <div class="recent-list">{recentWriting.map(entry => <article class="recent-entry"><time datetime={entry.data.publishDate.toISOString()}>{formatDate(entry.data.publishDate)}</time><div><h3><a href={articleHref(entry)}>{entry.data.title}</a></h3><p>{entry.data.description}</p><span class="reading-time">{readingTime(entry.body)}</span></div><Icon name="arrow-up-right" size={20} /></article>)}</div> : <div class="writing-empty"><div class="notebook-symbol" aria-hidden="true"><span></span><span></span><span></span></div><div><h3>The notebook is open.</h3><p>The first notes are still taking shape. This is where I’ll share what worked, what didn’t, and what I learned along the way.</p><a class="text-link" href="/writing/">Visit the writing desk <Icon name="arrow-right" size={15} /></a></div><span class="empty-note">No published posts yet</span></div>}
    </section>
    <section class="home-section intro-section" aria-labelledby="intro-title">
      <div><p class="eyebrow"><span class="section-number">03 /</span> The person behind the projects</p><h2 class="section-heading" id="intro-title">Hi, I’m Isaac.</h2></div>
      <div class="intro-copy"><p>I’m a husband, dad, and software engineer with roughly a decade of professional experience. After Bedtime Labs is where I follow my curiosity outside the day job.</p><p>Sometimes that means wrangling AI agents. Sometimes it means building a game. The common thread is making things and writing down what I learn.</p><div class="intro-links"><a class="text-link" href="/about/">A little more about me <Icon name="arrow-right" size={16} /></a><a href={site.github} class="text-link">GitHub <Icon name="arrow-up-right" size={14} /></a><a href={site.x} class="text-link">X <Icon name="arrow-up-right" size={14} /></a>{site.linkedin && <a href={site.linkedin} class="text-link">LinkedIn <Icon name="arrow-up-right" size={14} /></a>}</div></div>
    </section>
  </div>
</BaseLayout>
<style>
  .hero { display: grid; grid-template-columns: 1.35fr 1fr; column-gap: 30px; padding-top: 83px; }
  .hero .eyebrow { display: flex; align-items: center; gap: 11px; } .small-rule { display: inline-block; width: 22px; height: 1px; background: var(--accent); }
  .hero h1 { font-size: clamp(60px, 7.5vw, 96px); line-height: 1.04; letter-spacing: -.06em; font-weight: 550; margin-block: 27px 26px; }
  .hero h1 em { font-family: var(--font-serif); font-weight: 400; letter-spacing: -.065em; color: var(--accent); }
  .hero-description { max-width: 455px; font-size: 17px; line-height: 1.8; color: var(--muted); }
  .hero-link { display: inline-flex; align-items: center; gap: 22px; margin-top: 30px; padding-block: 8px; border-bottom: 1px solid var(--accent); text-decoration: none; font-size: 14px; font-weight: 550; }
  .hero-actions { display: flex; flex-wrap: wrap; align-items: baseline; gap: 14px 28px; }
  .hero-secondary { font-size: 13px; color: var(--muted); text-decoration: none; padding-block: 12px; }
  .hero-secondary span { margin-left: 8px; }
  .status-dot { display: inline-block; width: 6px; height: 6px; background: var(--accent); border-radius: 50%; margin-right: 7px; }
  .hero-art { align-self: center; margin-top: 20px; }
  .hero-footnote { grid-column: 1 / -1; display: flex; align-items: center; justify-content: space-between; margin-top: 67px; padding-bottom: 24px; color: var(--muted); font-size: 11px; }
  .hero-footnote span:last-child { font-family: var(--font-mono); font-size: 10px; text-transform: uppercase; letter-spacing: .1em; }
  .home-section { border-top: 1px solid var(--border); padding-top: 43px; margin-bottom: 56px; }
  .section-top { display: flex; align-items: flex-end; justify-content: space-between; gap: 20px; margin-bottom: 28px; }
  .section-heading { margin-top: 11px; } .section-number { color: var(--muted); margin-right: 8px; } .section-top > a { margin-bottom: 3px; }
  .featured-projects { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; }
  .navi-note { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 12px 24px; margin-top: 25px; padding-top: 22px; border-top: 1px solid var(--border); font-size: 14px; color: var(--muted); }
  .navi-note p { max-width: 650px; } .navi-note > a { font-size: 12px; } .navi-note p a { color: var(--text); font-weight: 600; }
  .writing-empty { display: grid; grid-template-columns: 46px 1fr auto; gap: 22px; padding: 31px 0 9px; align-items: start; }
  .writing-empty h3 { font-size: 21px; letter-spacing: -.025em; font-weight: 550; } .writing-empty p { max-width: 580px; color: var(--muted); font-size: 15px; margin-block: 9px 17px; }
  .empty-note { font-family: var(--font-mono); font-size: 10px; color: var(--muted); padding-top: 4px; }
  .notebook-symbol { border: 1px solid var(--border); border-radius: 3px; width: 37px; height: 43px; position: relative; padding: 10px 7px 8px 11px; }
  .notebook-symbol::before { content: ''; position: absolute; top: 0; bottom: 0; left: 6px; border-left: 1px solid var(--border); } .notebook-symbol span { display: block; height: 1px; width: 100%; margin-bottom: 6px; background: var(--accent); opacity: .6; } .notebook-symbol span:last-child { width: 65%; }
  .intro-section { display: grid; grid-template-columns: 1fr 1.1fr; gap: 70px; margin-bottom: 0; } .intro-copy p { font-size: 16px; color: var(--muted); } .intro-copy p + p { margin-top: 16px; }
  .intro-links { display: flex; flex-wrap: wrap; gap: 24px; margin-top: 25px; }
  .recent-entry { display: grid; grid-template-columns: 120px 1fr 20px; gap: 24px; padding-block: 24px; border-bottom: 1px solid var(--border); }
  .recent-entry time, .reading-time { font-size: 12px; color: var(--muted); } .recent-entry h3 { font-size: 23px; } .recent-entry h3 a { text-decoration: none; } .recent-entry p { font-size: 15px; color: var(--muted); margin-block: 8px; }
  @media (max-width: 980px) { .hero { grid-template-columns: 1.4fr 1fr; column-gap: 0; } .hero h1 { font-size: 78px; } .hero-art { margin-left: -20px; } .writing-empty { grid-template-columns: 40px 1fr; } .empty-note { grid-column: 2; padding-top: 0; } .intro-section { gap: 40px; } }
  @media (max-width: 760px) { .hero { padding-top: 51px; grid-template-columns: 1fr; } .hero h1 { font-size: clamp(60px, 12vw, 85px); } .hero-description { max-width: 470px; } .hero-art { max-width: 360px; width: 100%; margin: 22px auto 0; } .hero-footnote { margin-top: 28px; gap: 20px; } .hero-footnote span:last-child { display: none; } .featured-projects { grid-template-columns: 1fr; gap: 20px; } .home-section { padding-top: 32px; margin-bottom: 40px; } .section-top { margin-bottom: 23px; } .section-top > a { font-size: 12px; white-space: nowrap; } .intro-section { grid-template-columns: 1fr; gap: 24px; } .writing-empty { gap: 16px; padding-top: 16px; } .recent-entry { grid-template-columns: 1fr 20px; gap: 12px; } .recent-entry time { grid-column: 1 / -1; } .intro-links { gap: 20px; } }
  @media (max-width: 400px) { .hero .eyebrow { font-size: 9px; } .section-top { align-items: flex-start; } .section-top > a { margin-top: 32px; } .section-heading { font-size: 25px; } }
</style>

