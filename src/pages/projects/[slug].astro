---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectArtwork from '../../components/ProjectArtwork.astro';
import { projects, type Project } from '../../data/projects';

export const getStaticPaths = (() => projects.map((project) => ({
  params: { slug: project.slug },
  props: { project },
}))) satisfies GetStaticPaths;

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<BaseLayout title={project.name} description={project.summary}>
  <div class="container project-page">
    <a class="back-link" href="/projects/"><span aria-hidden="true">←</span> All projects</a>
    <header class="project-header">
      <p class="eyebrow">{project.category}</p>
      <h1 class="page-heading">{project.name}</h1>
      <p class="page-intro">{project.summary}</p>
    </header>
    <div class="project-hero"><ProjectArtwork artwork={project.artwork} /></div>
    <div class="project-detail">
      <section class="project-description" aria-labelledby="about-project">
        <h2 id="about-project">About this experiment</h2>
        {project.description.map((paragraph) => <p>{paragraph}</p>)}
        {(project.repositoryURL || project.websiteURL) && (
          <div class="project-links">
            {project.repositoryURL && <a class="text-link" href={project.repositoryURL}>View source <span aria-hidden="true">↗</span></a>}
            {project.websiteURL && <a class="text-link" href={project.websiteURL}>Visit project <span aria-hidden="true">↗</span></a>}
          </div>
        )}
      </section>
      <aside class="project-sidebar" aria-labelledby="areas-heading">
        <h2 id="areas-heading">Areas of interest</h2>
        <ul class="areas-list">{project.areas.map((area) => <li>{area}</li>)}</ul>
        <h2 class="topic-heading">Project topics</h2>
        <ul class="project-tags">{project.tags.map((tag) => <li class="tag">{tag}</li>)}</ul>
      </aside>
    </div>
    <div class="project-footer">
      <p>Notes from the workbench, as they take shape.</p>
      <a class="text-link" href="/writing/">Explore the writing <span aria-hidden="true">↗</span></a>
    </div>
  </div>
</BaseLayout>

<style>
  .project-page { padding-bottom: 5rem; }
  .back-link { display: inline-flex; align-items: center; gap: 0.6rem; margin-top: 3.5rem; color: var(--muted); text-decoration: none; font-size: 0.84rem; }
  .back-link:hover { color: var(--text); }
  .project-header { padding-top: 2.75rem; }
  .project-hero { margin: 2.75rem 0 3.5rem; height: 300px; border: 1px solid var(--border); border-radius: 7px; overflow: hidden; }
  .project-detail { display: grid; grid-template-columns: minmax(0, 2fr) minmax(210px, 1fr); gap: 4rem; }
  h2 { margin: 0 0 1.25rem; font-size: 1.25rem; letter-spacing: -0.035em; }
  .project-description p { color: var(--muted); line-height: 1.85; margin: 0 0 1.2rem; }
  .project-sidebar { border-left: 1px solid var(--border); padding-left: 2rem; }
  .project-sidebar h2 { font-family: var(--font-mono, ui-monospace, monospace); font-size: 0.71rem; letter-spacing: 0.075em; text-transform: uppercase; }
  .areas-list { margin: 0; padding: 0; list-style: none; font-size: 0.88rem; color: var(--muted); }
  .areas-list li { padding: 0.45rem 0; }
  .topic-heading { margin-top: 2rem; }
  .project-tags { display: flex; flex-wrap: wrap; gap: 0.5rem; padding: 0; margin: 0; list-style: none; }
  .project-links { display: flex; flex-wrap: wrap; gap: 1.5rem; margin-top: 2rem; font-size: 0.9rem; }
  .project-footer { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 1rem; margin-top: 4rem; border-top: 1px solid var(--border); padding-top: 1.5rem; color: var(--muted); font-size: 0.88rem; }
  .project-footer p { margin: 0; }
  @media (max-width: 700px) {
    .back-link { margin-top: 2rem; }
    .project-header { padding-top: 2rem; }
    .project-hero { height: 210px; margin: 2rem 0 2.5rem; }
    .project-detail { grid-template-columns: 1fr; gap: 2rem; }
    .project-sidebar { border-left: 0; border-top: 1px solid var(--border); padding: 1.75rem 0 0; }
  }
</style>
