---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { articleHref, formatDate, getPublishedWriting, getWriting, readingTime, type WritingEntry } from '../../lib/writing';

export const getStaticPaths = (async () => {
  const entries = await getWriting();
  return entries.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}) satisfies GetStaticPaths;

interface Props { entry: WritingEntry; }
const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const contents = headings.filter((heading) => heading.depth === 2);
const published = await getPublishedWriting();
const index = published.findIndex((article) => article.id === entry.id);
const older = index >= 0 ? published[index + 1] : undefined;
const newer = index > 0 ? published[index - 1] : undefined;
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.description}
  canonicalURL={entry.data.canonicalURL}
  image={entry.data.heroImage}
  imageAlt={entry.data.heroImageAlt}
  type="article"
  publishDate={entry.data.publishDate}
  updatedDate={entry.data.updatedDate}
  noindex={entry.data.draft}
>
  <article class="reading-container article-page">
    <a href="/writing/" class="text-link back-link"><span aria-hidden="true">←</span> All writing</a>
    <header class="article-header">
      <p class="eyebrow">Field notes {entry.data.draft && <span class="draft-label">Unpublished draft</span>}</p>
      <h1 class="article-title">{entry.data.title}</h1>
      <p class="article-description">{entry.data.description}</p>
      <div class="article-meta">
        <span>By Isaac</span>
        <span>{entry.data.draft ? 'Draft started ' : ''}<time datetime={entry.data.publishDate.toISOString()}>{formatDate(entry.data.publishDate)}</time></span>
        <span>{readingTime(entry.body)}</span>
      </div>
      {entry.data.updatedDate && <p class="article-updated">Updated <time datetime={entry.data.updatedDate.toISOString()}>{formatDate(entry.data.updatedDate)}</time></p>}
      {entry.data.tags.length > 0 && <ul class="article-tags" role="list" aria-label="Topics">
        {entry.data.tags.map((tag) => <li class="tag">{tag}</li>)}
      </ul>}
    </header>

    {entry.data.draft && <aside class="draft-notice">
      <strong>A note from the drafting table.</strong>
      <p>This article is unfinished and only available in local development. It is excluded from the production site and RSS feed.</p>
    </aside>}

    {entry.data.heroImage && <figure class="article-hero">
      <img src={entry.data.heroImage} alt={entry.data.heroImageAlt ?? ''} decoding="async" />
      {entry.data.heroImageCaption && <figcaption>{entry.data.heroImageCaption}</figcaption>}
    </figure>}

    {contents.length >= 3 && <nav class="table-of-contents" aria-labelledby="contents-heading">
      <h2 id="contents-heading">In this note</h2>
      <ol>{contents.map((heading) => <li><a href={`#${heading.slug}`}>{heading.text}</a></li>)}</ol>
    </nav>}

    <div class="prose"><Content /></div>

    {(older || newer) && <nav class="article-navigation" aria-label="More writing">
      <div>{older && <a href={articleHref(older)} rel="prev"><span class="navigation-label">← Older note</span><span>{older.data.title}</span></a>}</div>
      <div>{newer && <a href={articleHref(newer)} rel="next"><span class="navigation-label">Newer note →</span><span>{newer.data.title}</span></a>}</div>
    </nav>}
    <footer class="article-footer"><a class="text-link" href="/writing/">Back to the notebook <span aria-hidden="true">→</span></a></footer>
  </article>
</BaseLayout>

<style>
  .article-page { padding-block: 3rem 5rem; }
  .back-link { font-size: .82rem; display: inline-flex; align-items: center; gap: .6rem; }
  .article-header { margin-block: 3rem 2.8rem; }
  .article-title { font-size: clamp(2.2rem, 5.5vw, 3.75rem); line-height: 1.13; letter-spacing: -.05em; margin: 1rem 0 1.25rem; text-wrap: balance; }
  .article-description { color: var(--muted); font-size: 1.12rem; line-height: 1.75; margin: 0 0 1.6rem; }
  .article-meta { display: flex; flex-wrap: wrap; gap: .5rem 1.4rem; color: var(--muted); font-size: .8rem; }
  .article-updated { color: var(--muted); font-size: .78rem; margin-top: .6rem; }
  .article-tags { list-style: none; padding: 0; display: flex; flex-wrap: wrap; gap: .5rem; margin: 1.1rem 0 0; }
  .draft-label { display: inline-block; margin-left: .7rem; border: 1px solid var(--border); border-radius: 3px; padding: .15rem .4rem; font-size: .65rem; }
  .draft-notice { border-left: 2px solid var(--accent); background: var(--surface); padding: 1.1rem 1.3rem; margin-bottom: 2.5rem; font-size: .88rem; }
  .draft-notice p { color: var(--muted); margin: .5rem 0 0; line-height: 1.7; }
  .article-hero { margin: 0 0 3rem; }
  .article-hero img { width: 100%; height: auto; border-radius: 4px; }
  .article-hero figcaption { color: var(--muted); font-size: .78rem; line-height: 1.6; margin-top: .7rem; }
  .table-of-contents { border-block: 1px solid var(--border); padding: 1.3rem 0; margin-bottom: 3rem; }
  .table-of-contents h2 { font-family: var(--font-mono); color: var(--muted); font-size: .74rem; font-weight: 500; margin: 0 0 .85rem; }
  .table-of-contents ol { margin: 0; padding-left: 1.35rem; font-size: .9rem; }
  .table-of-contents li { padding-block: .3rem; }
  .table-of-contents a { color: inherit; text-decoration-color: var(--border); text-underline-offset: .2em; }
  .table-of-contents a:hover { color: var(--accent); }
  .article-navigation { border-top: 1px solid var(--border); display: grid; grid-template-columns: 1fr 1fr; gap: 2rem; margin-top: 3.5rem; padding-top: 1.8rem; }
  .article-navigation a { display: flex; flex-direction: column; gap: .7rem; text-decoration: none; color: inherit; font-size: .95rem; line-height: 1.5; }
  .article-navigation a:hover { color: var(--accent); }
  .article-navigation > :last-child { text-align: right; }
  .navigation-label { font-family: var(--font-mono); font-size: .7rem; color: var(--muted); }
  .article-footer { margin-top: 3rem; font-size: .86rem; }
  @media (max-width: 650px) {
    .article-page { padding-block: 2rem 3.5rem; }
    .article-header { margin-block: 2rem; }
    .article-navigation { grid-template-columns: 1fr; gap: 1.5rem; }
    .article-navigation > :last-child { text-align: left; }
  }
</style>
