---
import type { ProjectArtwork } from '../data/projects';

interface Props {
  artwork: ProjectArtwork;
}

const { artwork } = Astro.props;
---

<div class:list={['project-artwork', artwork]} aria-hidden="true">
  <svg viewBox="0 0 480 240" fill="none" xmlns="http://www.w3.org/2000/svg">
    <g class="grid" stroke="currentColor" stroke-width="1">
      {[60, 120, 180, 240, 300, 360, 420].map((x) => <path d={`M${x} 0V240`} />)}
      {[60, 120, 180].map((y) => <path d={`M0 ${y}H480`} />)}
    </g>
    {artwork === 'control' && (
      <g stroke="currentColor" stroke-width="1.5">
        <path class="connection" d="M140 76H200V120H240M140 164H200V120M280 120H330V76H366M330 120V164H366" />
        <rect class="node" x="93" y="61" width="47" height="30" rx="5" />
        <rect class="node" x="93" y="149" width="47" height="30" rx="5" />
        <rect class="central" x="240" y="100" width="40" height="40" rx="8" />
        <rect class="node" x="366" y="61" width="24" height="30" rx="5" />
        <rect class="node" x="366" y="149" width="24" height="30" rx="5" />
        <path class="detail" d="M104 72H129M104 80H121M104 160H123M104 168H129M252 113H268M252 120H268M252 127H263" />
        <circle class="point" cx="330" cy="120" r="3" />
      </g>
    )}
    {artwork === 'chiba' && (
      <g stroke="currentColor" stroke-width="1.3">
        <circle class="moon" cx="345" cy="64" r="22" />
        <path class="landscape" d="M0 170L70 135L128 158L205 101L282 154L329 132L390 163L480 118M0 195L104 178L180 187L275 166L360 187L480 167" />
        <path class="path" d="M233 240L242 218L234 203L257 181L275 166" />
        <path class="house" d="M102 179V158H137V179M96 158L119 140L143 158M117 179V164H125V179" />
        <path class="detail" d="M396 180V137M385 153L396 137L407 153M382 164L396 145L411 164" />
      </g>
    )}
    {artwork === 'deck' && (
      <g stroke="currentColor" stroke-width="1.4">
        <g transform="rotate(-15 175 124)">
          <rect class="node" x="129" y="63" width="78" height="116" rx="8" />
          <rect class="detail" x="137" y="71" width="62" height="100" rx="4" />
        </g>
        <g transform="rotate(15 305 124)">
          <rect class="node" x="273" y="63" width="78" height="116" rx="8" />
          <rect class="detail" x="281" y="71" width="62" height="100" rx="4" />
        </g>
        <rect class="central" x="200" y="54" width="80" height="127" rx="8" />
        <path class="symbol" d="M240 84L258 112L240 140L222 112Z" />
        <path class="detail" d="M218 156H262M227 163H253" />
      </g>
    )}
    {artwork === 'local' && (
      <g stroke="currentColor" stroke-width="1.4">
        <path class="connection" d="M173 88L226 112M173 154L226 128M254 112L307 88M254 128L307 154" />
        <rect class="central" x="225" y="105" width="30" height="30" rx="6" />
        <circle class="node" cx="161" cy="82" r="14" />
        <circle class="node" cx="161" cy="160" r="14" />
        <circle class="node" cx="319" cy="82" r="14" />
        <circle class="node" cx="319" cy="160" r="14" />
        <path class="detail" d="M156 82H166M161 77V87M156 160H166M314 82H324M314 160H324M319 155V165" />
        <path class="orbit" d="M120 120C120 62 170 30 240 30C310 30 360 62 360 120C360 178 310 210 240 210C170 210 120 178 120 120Z" stroke-dasharray="3 8" />
      </g>
    )}
    <g class="registration" stroke="currentColor" stroke-width="1">
      <path d="M20 30V20H30M450 20H460V30M20 210V220H30M450 220H460V210" />
    </g>
  </svg>
</div>

<style>
  .project-artwork {
    height: 100%;
    overflow: hidden;
    color: #c39861;
    background: #1e211f;
  }

  .project-artwork.chiba {
    color: #a4b99e;
    background: #202923;
  }

  .project-artwork.deck {
    color: #b6a2bc;
    background: #282329;
  }

  .project-artwork.local {
    color: #91b3b3;
    background: #20292a;
  }

  svg {
    display: block;
    width: 100%;
    height: 100%;
    min-height: 170px;
    object-fit: cover;
  }

  .grid { opacity: 0.065; }
  .registration { opacity: 0.3; }
  .connection, .landscape { opacity: 0.58; }
  .node { fill: #232724; }
  .chiba .moon { opacity: 0.8; fill: currentColor; fill-opacity: 0.03; }
  .deck .node { fill: #29232a; }
  .local .node { fill: #242d2e; }
  .central { fill: currentColor; fill-opacity: 0.08; }
  .detail, .path, .house { opacity: 0.7; }
  .point { fill: currentColor; }
  .orbit { opacity: 0.28; }
  .symbol { opacity: 0.8; fill: currentColor; fill-opacity: 0.05; }

  :global([data-theme='light']) .project-artwork {
    color: #88612f;
    background: #eee8df;
  }
  :global([data-theme='light']) .project-artwork.chiba {
    color: #536d50;
    background: #e8ece4;
  }
  :global([data-theme='light']) .project-artwork.deck {
    color: #7d5f80;
    background: #ece6ed;
  }
  :global([data-theme='light']) .project-artwork.local {
    color: #4c7070;
    background: #e4eceb;
  }
  :global([data-theme='light']) .node { fill: #eee8df; }
  :global([data-theme='light']) .deck .node { fill: #ece6ed; }
  :global([data-theme='light']) .local .node { fill: #e4eceb; }
</style>
