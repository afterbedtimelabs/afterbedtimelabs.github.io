<!-- This exact media element survives ClientRouter swaps. No stored autoplay state. -->
<audio data-audio="music" transition:persist="workshop-music" preload="none" loop src="/audio/ambient/after-hours.ogg"></audio>
<aside class="interior-music" aria-label="Workshop music" hidden>
  <span class="music-title">Window seat</span>
  <button type="button" data-audio-toggle="music" aria-pressed="false">Play music</button>
  <details class="sound-mixer">
    <summary aria-label="Music volume settings">Volume</summary>
    <div class="music-panel">
      <label for="interior-music-volume">Music <output data-music-level for="interior-music-volume">40%</output></label>
      <input data-music-volume id="interior-music-volume" type="range" min="0" max="100" value="40" />
      <button type="button" class="mute-button" aria-pressed="false">Mute music</button>
    </div>
  </details>
  <p class="audio-status sr-only" role="status" aria-live="polite"></p>
</aside>
<script>
  import '../scripts/music-player';
</script>
<style>
  .interior-music { position:fixed; bottom:18px; right:24px; z-index:10; display:flex; align-items:center; gap:10px; max-width:calc(100% - 32px); padding:9px 12px; border:1px solid var(--border); border-radius:9px; background:var(--surface); color:var(--text); box-shadow:0 4px 24px #0002; }
  .interior-music[hidden] { display:none; }
  .music-title { font:10px var(--font-mono); color:var(--muted); }
  button,summary { min-height:44px; padding:10px; border:1px solid var(--border); border-radius:5px; background:transparent; color:var(--text); font-size:12px; cursor:pointer; }
  button:hover,summary:hover { border-color:var(--accent); color:var(--accent); }
  summary { list-style:none; }
  summary::-webkit-details-marker { display:none; }
  .sound-mixer { position:relative; }
  .music-panel { position:absolute; right:0; bottom:calc(100% + 20px); width:230px; padding:18px; border:1px solid var(--border); border-radius:9px; background:var(--bg); box-shadow:0 4px 24px #0002; }
  label { display:flex; justify-content:space-between; font-size:12px; }
  input { width:100%; height:36px; accent-color:var(--accent); }
  .mute-button { width:100%; }
  :global(body.has-interior-music) { padding-bottom:100px; }
  @media(max-width:480px) { .interior-music { bottom:12px; right:16px; gap:7px; padding:7px 9px; } }
</style>
