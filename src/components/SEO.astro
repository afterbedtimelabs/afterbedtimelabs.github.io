---
import { site } from '../config/site';
export interface Props {
  title?: string;
  description?: string;
  canonicalURL?: string;
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article';
  publishDate?: Date;
  updatedDate?: Date;
  noindex?: boolean;
}
const { title, description = site.description, canonicalURL, image = site.socialImage,
  imageAlt = site.imageAlt, type = 'website', publishDate, updatedDate, noindex = false } = Astro.props;
const pageTitle = title ? `${title} · ${site.name}` : `${site.name} — Software, AI & games by Isaac`;
const baseURL = Astro.site ?? new URL(site.url);
const canonical = canonicalURL ?? new URL(Astro.url.pathname, baseURL).href;
const socialImage = image ? new URL(image, baseURL).href : undefined;
---
<title>{pageTitle}</title>
<meta name="description" content={description} />
<meta name="author" content={site.author} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex, nofollow" />}
<meta property="og:site_name" content={site.name} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
<meta property="og:type" content={type} />
<meta property="og:url" content={canonical} />
<meta property="og:locale" content="en_US" />
{socialImage && <meta property="og:image" content={socialImage} />}
{socialImage && <meta property="og:image:alt" content={imageAlt} />}
<meta name="twitter:card" content={socialImage ? 'summary_large_image' : 'summary'} />
<meta name="twitter:site" content={site.xHandle} />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={description} />
{socialImage && <meta name="twitter:image" content={socialImage} />}
{socialImage && <meta name="twitter:image:alt" content={imageAlt} />}
{type === 'article' && publishDate && <meta property="article:published_time" content={publishDate.toISOString()} />}
{type === 'article' && updatedDate && <meta property="article:modified_time" content={updatedDate.toISOString()} />}
