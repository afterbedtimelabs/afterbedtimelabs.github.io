---
import ProjectMedia from './ProjectMedia.astro';
import { getProjectPath, type Project } from '../data/projects';

interface Props {
  project: Project;
  compact?: boolean;
  spotlight?: boolean;
}

const { project, compact = false, spotlight = false } = Astro.props;
const Heading = compact ? 'h3' : 'h2';
---

<article class:list={['project-card', { compact, spotlight }]}>
  <a class="project-visual" href={getProjectPath(project)} tabindex="-1" aria-hidden="true">
    <ProjectMedia project={project} decorative />
  </a>
  <div class="project-copy">
    <p class="project-category">{spotlight ? 'In the spotlight · ' : ''}{project.category}</p>
    {project.status && <p class="project-status"><span aria-hidden="true"></span>{project.status}</p>}
    <Heading><a href={getProjectPath(project)}>{project.name}<span aria-hidden="true">↗</span></a></Heading>
    <p class="project-summary">{project.summary}</p>
    {project.availability && <p class="availability">{project.availability}</p>}
    <ul class="project-tags" aria-label="Project topics">
      {project.tags.map((tag) => <li class="tag">{tag}</li>)}
    </ul>
    {project.introduction && <a class="text-link introduction-link" href={project.introduction}>Meet {project.name} <span aria-hidden="true">→</span></a>}
  </div>
</article>

<style>
  .introduction-link { display: inline-block; margin-top: 1rem; font-size: .88rem; }
  .project-card {
    display: grid;
    grid-template-columns: minmax(220px, 0.95fr) minmax(0, 1.5fr);
    gap: 2.5rem;
    padding: 2.3rem 0;
    border-top: 1px solid var(--border);
    align-items: center;
  }

  .project-visual {
    display: block;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: 7px;
  }

  .project-category {
    margin: 0 0 0.65rem;
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 0.7rem;
    letter-spacing: 0.075em;
    color: var(--muted);
    text-transform: uppercase;
  }

  :is(h2, h3) {
    margin: 0;
    font-size: 1.65rem;
    letter-spacing: -0.045em;
    line-height: 1.3;
  }

  :is(h2, h3) a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    color: var(--text);
    text-decoration: none;
  }

  :is(h2, h3) a:hover { color: var(--accent); }
  :is(h2, h3) span { color: var(--muted); font-size: 1.2rem; font-weight: 400; }
  .project-summary { margin: 0.9rem 0 1.3rem; max-width: 48ch; color: var(--muted); line-height: 1.75; font-size: 0.94rem; }
  .project-tags { display: flex; flex-wrap: wrap; gap: 0.5rem; margin: 0; padding: 0; list-style: none; }

  .compact {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 1.5rem;
    padding: 0;
    border-top: 0;
  }

  .project-status { display: flex; align-items: center; gap: 7px; color: var(--accent); font: 11px var(--font-mono); margin-bottom: 12px; }
  .project-status span { width: 5px; height: 5px; border-radius: 50%; background: currentColor; }
  .availability { font-size: 12px; color: var(--muted); margin: -6px 0 18px; }
  .compact .project-visual { aspect-ratio: 16 / 9; }
  .compact h3 { font-size: 1.35rem; }
  .compact .project-summary { margin-top: 0.7rem; font-size: 0.9rem; }

  .spotlight { grid-column: 1 / -1; display: grid; grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr); align-items: center; gap: 2rem; padding: 1.5rem; border: 1px solid var(--border); border-radius: 9px; background: var(--surface); }
  .spotlight h3 { font-size: 1.8rem; }
  .spotlight .project-category { color: var(--accent); }
  @media (max-width: 900px) { .spotlight { grid-template-columns: 1fr; } }

  @media (max-width: 650px) {
    .project-card { grid-template-columns: 1fr; gap: 1.5rem; padding: 1.9rem 0; }
    .compact { padding: 0; }
    .spotlight { padding: 1rem; }
    :is(h2, h3) { font-size: 1.45rem; }
  }
</style>
